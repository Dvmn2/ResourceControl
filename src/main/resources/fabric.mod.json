{
  "schemaVersion": 1,
  "id": "resourcecontrol",
  "version": "${version}",
  "name": "ResourceControl",
  "description": "Applies per-player resource packs sent by the ResourceControlPlugin server plugin.",
  "authors": ["DVMN2"],
  "contact": {},
  "license": "All-Rights-Reserved",
  "environment": "client",
  "entrypoints": {
    "client": ["net.dvmn2.resourcecontrol.client.ResourceControlClient"]
  },
  "mixins": [
    {
      "config": "resourcecontrol.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}

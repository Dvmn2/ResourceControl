{
  "schemaVersion": 1,
  "id": "resourcecontrol",
  "version": "${version}",
  "name": "ResourceControl",
  "description": "Applies per-player resource packs pushed by the ResourceControlPlugin server plugin.",
  "authors": [],
  "contact": {},
  "license": "All-Rights-Reserved",
  "icon": "assets/resourcecontrol/icon.png",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "net.dvmn2.resourcecontrol.client.ResourceControlDataGenerator"
    ],
    "client": [
      "net.dvmn2.resourcecontrol.client.ResourceControlClient"
    ],
    "main": [
      "net.dvmn2.resourcecontrol.ResourceControl"
    ]
  },
  "mixins": [
    "resourcecontrol.mixins.json",
    {
      "config": "resourcecontrol.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
